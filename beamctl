def emit(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


def run(cmd, timeout=10):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)


# ----------------------------------------------------------------- discovery

def avahi_unescape(text):
    """avahi-browse -p writes non-alphanumeric bytes as \\DDD (decimal)."""
    raw = re.sub(r"\\(\d{3})", lambda m: chr(int(m.group(1))), text)
    try:
        return raw.encode("latin-1").decode("utf-8")
    except (UnicodeEncodeError, UnicodeDecodeError):
        return raw


def parse_txt(fields):
    txt = {}
    for item in re.findall(r'"((?:[^"\\]|\\.)*)"', ";".join(fields)):
        if "=" in item:
            k, v = item.split("=", 1)
            txt[k.lower()] = v
    return txt


def parse_avahi_line(line):
    """One resolved `=` line from `avahi-browse -rp`, or None."""
    if not line.startswith("="):
        return None
    f = line.rstrip("\n").split(";")
    if len(f) < 9:
        return None
    try:
        port = int(f[8])
    except ValueError:
        return None
    return {
        # = ; iface ; proto ; name ; type ; domain ; hostname ; address ; port ; txt
        "iface": f[1], "proto": f[2], "name": avahi_unescape(f[3]), "type": f[4],
        "host": f[6], "address": f[7], "port": port,
        "txt": parse_txt(f[9:]) if len(f) > 9 else {},
    }


def group_receivers(airplay, raop):
    """Merge _airplay._tcp and _raop._tcp records into one entry per device.

    Legacy receivers (Horion panels among them) advertise the HTTP AirPlay
    service and the RTSP mirroring service on different ports, so every
    advertised port becomes a candidate and the probe picks the one that
    answers RTSP.
    """
    devices = {}

    def entry(key):
        return devices.setdefault(key, {"deviceId": "", "name": "", "model": "", "host": "",
                                        "raopPort": None, "airplayPort": None, "features": ""})

    def better_host(cur, new):
        if not new:
            return cur
        if not cur:
            return new
        # IPv4 wins, then anything that is not link-local IPv6.
        if ":" in cur and ":" not in new:
            return new
        return cur

    for r in airplay:
        did = r["txt"].get("deviceid", "").upper() or r["name"]
        d = entry(did)
        d["deviceId"] = r["txt"].get("deviceid", "").upper()
        d["name"] = r["name"]
        d["model"] = r["txt"].get("model", d["model"])
        d["features"] = r["txt"].get("features", d.get("features", ""))
        if d["airplayPort"] is None or ":" not in r["address"]:
            d["airplayPort"] = r["port"]
        d["host"] = better_host(d["host"], r["address"])
    for r in raop:
        prefix, _, name = r["name"].partition("@")
        mac = ":".join(prefix[i:i + 2] for i in range(0, len(prefix), 2)) if re.fullmatch(r"[0-9A-Fa-f]{12}", prefix) else prefix
        did = mac.upper() if name else r["name"]
        d = entry(did)
        if not d["deviceId"] and name:
            d["deviceId"] = did
        if not d["name"]:
            d["name"] = name or r["name"]
        if not d["model"]:
            d["model"] = r["txt"].get("am", "")
        if d["raopPort"] is None or ":" not in r["address"]:
            d["raopPort"] = r["port"]
        d["host"] = better_host(d["host"], r["address"])

    out = []
    for d in devices.values():
        cands = []
        for p in (d["raopPort"], d["airplayPort"], 7000):
            if p and p not in cands:
                cands.append(p)
        d["candidates"] = cands
        d["screen"] = is_screen(d)
        out.append(d)
    return sorted(out, key=lambda d: d["name"].lower())


# Models that only ever play sound: HomePods and AirPort Express base stations.
AUDIO_ONLY_MODELS = ("AudioAccessory", "AirPort")


def is_screen(d):
    """Whether a receiver can show a mirrored screen, judged from what it advertises.

    Speakers advertise AirPlay too. A receiver without an _airplay._tcp record
    is RAOP-only (sound); Apple's speakers are known by model; and anything
    else that advertises features without bit 7 (screen mirroring) can't take
    a mirror stream. Unknown receivers are kept rather than hidden.
    """
    if d.get("airplayPort") is None:
        return False
    if d.get("model", "").startswith(AUDIO_ONLY_MODELS):
        return False
    features = d.get("features", "")
    if features:
        try:
            low = int(features.split(",")[0], 16)
        except ValueError:
            return True
        return bool(low & (1 << 7))
    return True


def probe_rtsp(host, port, timeout=1.5):
    try:
        with socket.create_connection((host, port), timeout=timeout) as s:
            s.settimeout(timeout)
            s.sendall(b"GET /info RTSP/1.0\r\nCSeq: 1\r\nUser-Agent: AirPlay/220.68\r\n\r\n")
            head = s.recv(64)
        return head.startswith(b"RTSP/1.0 200")
    except OSError:
        return False


def browse(service, timeout=8):
    code, out, _ = run(["avahi-browse", "-rptk", service], timeout=timeout)
    return [r for r in (parse_avahi_line(l) for l in out.splitlines()) if r]


def network_info():
    info = {"iface": "", "ssid": "", "ip": ""}
    code, out, _ = run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"], timeout=4)
    for line in out.splitlines():
        parts = line.split(":", 3)
        if len(parts) == 4 and parts[1] == "wifi" and parts[2] == "connected":
            info["iface"], info["ssid"] = parts[0], parts[3].replace("\\:", ":")
            break
    if not info["iface"]:
        # Wired, or Wi-Fi not managed by NetworkManager: the default route's
        # interface is the network the screens are on.
        code, out, _ = run(["ip", "-4", "route", "show", "default"], timeout=3)
        m = re.search(r"\bdev (\S+)", out)
        if m:
            info["iface"] = m.group(1)
    if info["iface"]:
        code, out, _ = run(["ip", "-4", "-o", "addr", "show", "dev", info["iface"]], timeout=3)
        m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", out)
        if m:
            info["ip"] = m.group(1)
    return info


def cmd_discover(show_all=False):
    with concurrent.futures.ThreadPoolExecutor(4) as pool:
        fa = pool.submit(browse, "_airplay._tcp")
        fr = pool.submit(browse, "_raop._tcp")
        fn = pool.submit(network_info)
        devices = [d for d in group_receivers(fa.result(), fr.result()) if show_all or d["screen"]]

        def resolve(d):
            d["port"], d["reachable"] = (d["candidates"][0] if d["candidates"] else 7000), False
            if d["host"]:
                for p in d["candidates"]:
                    if probe_rtsp(d["host"], p):
                        d["port"], d["reachable"] = p, True
                        break
            return d

        devices = list(pool.map(resolve, devices))
        net = fn.result()
    for d in devices:
        for k in ("raopPort", "airplayPort", "features"):
            d.pop(k, None)
    emit({"ok": True, "network": net, "devices": devices})


# -------------------------------------------------------------------- doctor

def find_doubletake():
    env = os.environ.get("BEAM_DOUBLETAKE")
    for path in [env, os.path.join(PLUGIN_DIR, "doubletake"), os.path.join(LIB_DIR, "doubletake"),
                 shutil.which("doubletake")]:
        if path and os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return ""


def missing_packages(names):
    code, out, err = run(["pacman", "-Q"] + names)
    return re.findall(r"package '([^']+)' was not found", err)


def ufw_enabled():
    try:
        with open("/etc/ufw/ufw.conf") as f:
            if re.search(r"^\s*ENABLED\s*=\s*yes", f.read(), re.M):
                return True
    except OSError:
        pass
    code, out, _ = run(["systemctl", "is-active", "ufw"], timeout=3)
    return out.strip() == "active"


def ufw_allows(rules_text, ip):
    """True when a ufw user rule opens UDP 60000:60010 to traffic from ip."""
    if not ip:
        return False
    addr = ipaddress.ip_address(ip)
    for line in rules_text.splitlines():
        m = re.match(r"### tuple ### allow (udp|any) (\S+) (\S+) (\S+) (\S+) in", line)
        if not m:
            continue
        dport, src = m.group(2), m.group(5)
        ports = dport.replace(",", " ").split()
        covered = False
        for p in ports:
            lo, _, hi = p.partition(":")
            try:
                lo, hi = int(lo), int(hi or lo)
            except ValueError:
                continue
            if lo <= 60000 and hi >= 60010:
                covered = True
        if dport == "any":
            covered = True
        if not covered:
            continue
        try:
            if addr in ipaddress.ip_network(src, strict=False):
                return True
        except ValueError:
            continue
    return False


def doctor():
    checks = []
    fixes = []

    dt = find_doubletake()
    checks.append({"id": "doubletake", "ok": bool(dt), "label": "doubletake",
                   "detail": dt or "Not installed yet; Set up Beam downloads it."})

    missing = missing_packages(REQUIRED_PACKAGES)
    checks.append({"id": "packages", "ok": not missing, "label": "GStreamer and audio packages",
                   "detail": "Missing: " + " ".join(missing) if missing else "Installed"})
    if missing:
        fixes.append("sudo pacman -S --needed " + " ".join(missing))

    opt = missing_packages(OPTIONAL_PACKAGES)
    checks.append({"id": "aac", "ok": not opt, "optional": True, "label": "AAC sound (optional)",
                   "detail": "Missing libfdk-aac; sound falls back to ALAC" if opt else "Installed"})

    code, out, _ = run(["systemctl", "is-active", "avahi-daemon"], timeout=3)
    avahi_ok = out.strip() == "active"
    checks.append({"id": "avahi", "ok": avahi_ok, "label": "Screen discovery (avahi)",
                   "detail": "Running" if avahi_ok else "avahi-daemon is not running"})
    if not avahi_ok:
        fixes.append("sudo systemctl enable --now avahi-daemon")

    net = network_info()
    if ufw_enabled():
        rules = read_rules()
        readable = bool(rules) or os.access(UFW_RULES, os.R_OK)
        permanent = readable and ufw_allows(rules, net["ip"])
        pkexec = bool(shutil.which("pkexec")) and bool(ufw_path())
        if permanent:
            fw_ok, detail = True, ("UDP 60000-60010 is open permanently for this network. Beam doesn't "
                                   "need that rule; it opens the port per cast.")
        elif pkexec:
            fw_ok, detail = True, "Opened for the screen only while casting; asks for your password"
        else:
            fw_ok, detail = False, "ufw is on and pkexec is missing, so Beam can't open the port per cast"
        checks.append({"id": "firewall", "ok": fw_ok, "label": "Firewall", "detail": detail,
                       "permanent": permanent})
        if not fw_ok:
            fixes.append("sudo pacman -S --needed polkit")
        helpers_ok = helpers_installed()
        checks.append({"id": "prompts", "ok": helpers_ok, "label": "Readable firewall prompts",
                       "detail": "Installed" if helpers_ok else
                       "Not installed or outdated; the password dialog would show a raw ufw command"})
        if not helpers_ok:
            fixes.extend(helper_install_commands())
    else:
        checks.append({"id": "firewall", "ok": True, "label": "Firewall", "detail": "ufw is off"})

    ok = all(c["ok"] for c in checks if not c.get("optional"))
    return {"ok": ok, "network": net, "checks": checks, "fixes": fixes,
            "fixScript": " && ".join(fixes)}


def cmd_doctor():
    emit(doctor())


def open_terminal(command):
    """Run a beamctl command in a terminal, where sudo can ask for a password."""
    script = " ".join(shlex_quote(a) for a in [sys.executable, os.path.realpath(__file__)] + command)
    launcher = shutil.which("omarchy-launch-floating-terminal-with-presentation")
    if launcher:
        cmd = [launcher, script]
    else:
        cmd = ["xdg-terminal-exec", "bash", "-c", script + "; read -rp 'Press Enter to close'"]
    subprocess.Popen(cmd, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_fix():
    d = doctor()
    if d["ok"]:
        emit({"ok": True, "launched": False, "message": "Nothing to fix"})
    # setup runs the same fixes and records them, so uninstall can undo them.
    open_terminal(["setup"])
    emit({"ok": True, "launched": True, "commands": d["fixes"]})


def shlex_quote(s):
    import shlex
    return shlex.quote(s)


def download(url, dest, sha256):
    tmp = dest + ".part"
    h = hashlib.sha256()
    with urllib.request.urlopen(url, timeout=60) as r, open(tmp, "wb") as f:
        total = 0
        while True:
            chunk = r.read(1 << 16)
            if not chunk:
                break
            total += len(chunk)
            if total > 64 << 20:
                raise ValueError("download larger than 64 MB")
            h.update(chunk)
            f.write(chunk)
    if h.hexdigest() != sha256:
        os.unlink(tmp)
        raise ValueError(f"checksum mismatch for {url}")
    os.replace(tmp, dest)


def install_doubletake():
    """Download the pinned doubletake for this machine; returns its path or raises."""
    machine = os.uname().machine
    if machine not in DOUBLETAKE_ASSETS:
        raise ValueError(f"doubletake has no release build for {machine}; build it from source")
    asset, sha256 = DOUBLETAKE_ASSETS[machine]
    os.makedirs(LIB_DIR, exist_ok=True)
    dest = os.path.join(LIB_DIR, "doubletake")
    download(DOUBLETAKE_BASE + asset, dest, sha256)
    os.chmod(dest, 0o755)
    download(LICENSE_URL, os.path.join(LIB_DIR, "LICENSE.doubletake"), LICENSE_SHA256)
    return dest


def cmd_install_doubletake():
    try:
        dest = install_doubletake()
    except Exception as e:  # network, checksum, disk, unsupported machine
        emit({"ok": False, "error": str(e)}, 1)
    emit({"ok": True, "path": dest, "version": DOUBLETAKE_VERSION})


def read_record():
    try:
        with open(SETUP_RECORD) as f:
            data = json.load(f)
            return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def update_record(packages=(), **flags):
    rec = read_record()
    rec["packages"] = sorted(set(rec.get("packages", [])) | set(packages))
    for k, v in flags.items():
        if v:
            rec[k] = True
    os.makedirs(DATA_DIR, exist_ok=True)
    tmp = SETUP_RECORD + ".tmp"
    with open(tmp, "w") as f:
        json.dump(rec, f, indent=2)
    os.replace(tmp, SETUP_RECORD)


def avahi_active():
    code, out, _ = run(["systemctl", "is-active", "avahi-daemon"], timeout=3)
    return out.strip() == "active"


def cmd_setup():
    """Everything a new machine needs, in the terminal it was run from.

    Human-readable rather than JSON: this is the one command people type.
    Everything it changes is written to SETUP_RECORD for `uninstall`.
    """
    missing_before = missing_packages(REQUIRED_PACKAGES)
    if not shutil.which("pkexec") and ufw_enabled():
        missing_before.append("polkit")
    avahi_before = avahi_active()
    if not find_doubletake():
        print(f"Downloading doubletake {DOUBLETAKE_VERSION} into {LIB_DIR} ...")
        try:
            print("  installed", install_doubletake())
        except Exception as e:
            print("  failed:", e)
            sys.exit(1)
    d = doctor()
    for cmd in d["fixes"]:
        print("+", cmd)
        if subprocess.call(cmd, shell=True) != 0:
            print("Failed:", cmd)
            sys.exit(1)
        # Record each change as soon as it has happened, so an uninstall
        # after a half-finished setup still undoes the part that ran.
        if cmd.startswith("sudo pacman -S"):
            update_record(packages=[p for p in missing_before if p in cmd.split()])
        elif "enable --now avahi-daemon" in cmd and not avahi_before:
            update_record(avahiEnabled=True)
        elif HELPER_DIR in cmd or POLICY_PATH in cmd:
            update_record(helpers=True)
    d = doctor()
    for c in d["checks"]:
        mark = "ok " if c["ok"] else ("-- " if c.get("optional") else "!! ")
        print(f"{mark} {c['label']}: {c['detail']}")
    print("Ready to cast." if d["ok"] else "Some checks still fail; see above.")
    sys.exit(0 if d["ok"] else 1)


# ------------------------------------------------------------------ firewall

def ufw_path():
    return shutil.which("ufw") or ("/usr/bin/ufw" if os.path.exists("/usr/bin/ufw") else "")


def read_rules():
    try:
        with open(UFW_RULES) as f:
            return f.read()
    except OSError:
        return ""


def rule_for_host(rules_text, host):
    """True when ufw has exactly Beam's per-cast rule for host."""
    want = re.compile(r"### tuple ### allow udp " + re.escape(UFW_RANGE) + r" \S+ any "
                      + re.escape(host) + r"(/32)? in\b")
    return any(want.match(l) for l in rules_text.splitlines())


def ufw_rule(host):
    return ["allow", "from", host, "to", "any", "port", UFW_RANGE, "proto", "udp"]


def read_firewall():
    try:
        with open(FIREWALL_PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_firewall(data):
    os.makedirs(STATE_DIR, exist_ok=True)
    if not data:
        try:
            os.unlink(FIREWALL_PATH)
        except FileNotFoundError:
            pass
        return
    tmp = FIREWALL_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, FIREWALL_PATH)


def system_files():
    """(source in this checkout, installed path, mode) for each privileged file."""
    files = [(os.path.join(SYSTEM_DIR, name), os.path.join(HELPER_DIR, name), "755") for name in HELPERS.values()]
    files.append((os.path.join(SYSTEM_DIR, POLICY_NAME), POLICY_PATH, "644"))
    return files


def helpers_installed():
    """True when every helper and the policy are installed, root-owned and current."""
    for src, dest, _ in system_files():
        try:
            st = os.stat(dest)
            with open(src, "rb") as a, open(dest, "rb") as b:
                if a.read() != b.read():
                    return False
        except OSError:
            return False
        if st.st_uid != 0 or st.st_mode & 0o022:
            return False
    return True


def helper_install_commands():
    return [f"sudo install -D -o root -g root -m {mode} {shlex_quote(src)} {shlex_quote(dest)}"
            for src, dest, mode in system_files()]


def pkexec_ufw(args):
    """Run the firewall change as root through polkit; Omarchy's shell shows the
    password dialog. With Beam's helpers installed the dialog shows Beam's own
    message; without them it falls back to pkexec on ufw itself."""
    pk, ufw = shutil.which("pkexec"), ufw_path()
    if not pk or not ufw:
        return 127, "pkexec or ufw is missing"
    if helpers_installed():
        action = "close" if args[0] == "delete" else "open"
        host = args[args.index("from") + 1]
        cmd = [pk, os.path.join(HELPER_DIR, HELPERS[action]), host]
    else:
        cmd = [pk, ufw] + args
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
    except subprocess.TimeoutExpired:
        return 124, "password dialog timed out"
    msg = (r.stdout + r.stderr).strip()
    if r.returncode in (126, 127) and not msg:
        msg = "password dialog dismissed"
    return r.returncode, msg


def firewall_open(host):
    """Let the screen at host reach UDP 60000-60010 while casting.

    Returns (ok, message). Nothing to do when ufw is off or a rule (Beam's own
    from an earlier cast, or a permanent one) already lets the screen in.
    """
    if not ufw_enabled():
        return True, "ufw is off"
    rules = read_rules()
    if ufw_allows(rules, host):
        state = read_firewall()
        if state.get("host") == host:
            return True, "already open from an earlier cast"
        return True, "an existing rule already allows the screen"
    code, msg = pkexec_ufw(ufw_rule(host))
    if code != 0:
        return False, msg or f"ufw exited with {code}"
    write_firewall({"host": host, "openedAt": time.time()})
    if not rule_for_host(read_rules(), host):
        return False, "ufw reported success but the rule isn't in /etc/ufw/user.rules"
    return True, "opened"


def firewall_close():
    """Remove the per-cast rule Beam recorded, if it is still there."""
    import fcntl
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(os.path.join(STATE_DIR, "firewall.lock"), "w") as lock:
        # The watcher and a click on Close firewall can both get here; the
        # lock makes the second one find nothing left to do, so there is never
        # a second password prompt for the same rule.
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = read_firewall()
        host = state.get("host", "")
        if not host:
            return True, "nothing to close"
        if not rule_for_host(read_rules(), host):
            write_firewall({})
            return True, "rule was already gone"
        code, msg = pkexec_ufw(["delete"] + ufw_rule(host))
        if code != 0:
            return False, msg or f"ufw exited with {code}"
        if rule_for_host(read_rules(), host):
            return False, "ufw reported success but the rule is still there"
        write_firewall({})
        return True, "closed"


def cmd_firewall_close():
    ok, msg = firewall_close()
    emit({"ok": ok, "message": msg} if ok else {"ok": False, "error": "Firewall rule not removed: " + msg},
         0 if ok else 1)


def firewall_status(casting):
    """What the panel shows about the per-cast rule."""
    state = read_firewall()
    host = state.get("host", "")
    if not host:
        return {}
    alive = bool(state.get("watcher")) and "_watch" in " ".join(proc_cmdline(state["watcher"]))
    present = rule_for_host(read_rules(), host)
    if not present:
        if not casting and not alive:
            write_firewall({})
        return {}
    return {"host": host, "stale": not casting and not alive}


def cmd_watch(pid):
    """Outlive the cast: when doubletake exits, however it ends, put the sound
    output back and remove the firewall rule."""
    state = read_firewall()
    if state:
        state["watcher"] = os.getpid()
        write_firewall(state)
    while is_doubletake(pid):
        time.sleep(1)
    if handed_over(pid, read_session()):
        return
    restore_sink(read_session().get("prevSink", ""))
    firewall_close()


def handed_over(pid, sess):
    """Whether the cast that was pid has been replaced by a new one (Source…).

    The replacement keeps the firewall rule and the saved sound output, so the
    old cast's watcher must leave both alone. The session names the cast being
    replaced from before it is stopped until the new one has started.
    """
    if sess.get("handoverFrom") == pid:
        return True
    new = sess.get("pid")
    return bool(new) and new != pid and is_doubletake(new)


def cmd_change_source():
    sess = read_session()
    pid = sess.get("pid")
    if not (pid and is_doubletake(pid)):
        emit({"ok": False, "error": "Only a cast started from Beam can change its source"}, 1)
    sess["handoverFrom"] = pid
    write_session(sess)
    for sig, wait in ((signal.SIGINT, 5), (signal.SIGTERM, 3), (signal.SIGKILL, 2)):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            break
        if wait_exit(pid, wait):
            break
    argv = [sess.get("host", ""), str(sess.get("port", 7000)), "--choose"]
    if sess.get("deviceId"):
        argv += ["--device-id", sess["deviceId"]]
    if sess.get("name"):
        argv += ["--name", sess["name"]]
    if sess.get("audio"):
        argv.append("--audio")
    if sess.get("cursor") is False:
        argv.append("--no-cursor")
    # The old cast's doubletake output is gone now, so the default sink is not
    # the one to put back later: carry the original over.
    os.environ["BEAM_PREV_SINK"] = sess.get("prevSink", "")
    os.environ["BEAM_HANDOVER_FROM"] = str(pid)
    cmd_start(argv)


# ------------------------------------------------------------------- session

def read_session():
    try:
        with open(SESSION_PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_session(data):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = SESSION_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, SESSION_PATH)


def proc_cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return []


def is_doubletake(pid):
    args = proc_cmdline(pid)
    return bool(args) and os.path.basename(args[0]) == "doubletake"


def doubletake_processes():
    out = []
    # doubletake forks a helper with the same argv0 (--internal-audio-output-guard);
    # it exits with its parent, so only the casting process counts.
    for name in os.listdir("/proc"):
        if name.isdigit() and is_doubletake(int(name)):
            if not any(a.startswith("--internal") for a in proc_cmdline(int(name))):
                out.append(int(name))
    return out


def arg_value(args, flag):
    for i, a in enumerate(args):
        if a in (flag, "-" + flag) and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(flag + "=") or a.startswith("-" + flag + "="):
            return a.split("=", 1)[1]
    return ""


ERROR_RE = re.compile(r"error|failed|fatal|panic|refused|timed? ?out|no route|unreachable", re.I)


def log_state(text):
    """Map doubletake's log to a cast phase, the last error, and whether it wants a PIN."""
    lines = [l for l in text.splitlines() if l.strip()]
    state = "connecting"
    for l in lines:
        if "connected to:" in l:
            state = "pairing"
        if "mirror session ready" in l:
            state = "live"
    ended = any(("stream ended" in l or "shutting down" in l) for l in lines)
    needs_code = bool(re.search(r"Enter the (PIN|code)|run again with -pair", text))
    last_error = ""
    for l in reversed(lines):
        if ERROR_RE.search(l):
            last_error = re.sub(r"^\d{4}/\d\d/\d\d \d\d:\d\d:\d\d ", "", l).strip()[:300]
            break
    return {"phase": state, "ended": ended, "needsCode": needs_code, "lastError": last_error}


def tail(path, n=40):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - 64 * 1024))
            data = f.read().decode(errors="replace")
    except OSError:
        return ""
    return "\n".join(data.splitlines()[-n:])


def cmd_status():
    sess = read_session()
    pid = sess.get("pid")
    ours = bool(pid) and is_doubletake(pid)
    log = tail(LOG_PATH, 200) if sess else ""
    info = log_state(log) if log else {"phase": "idle", "ended": False, "needsCode": False, "lastError": ""}

    if ours:
        state = info["phase"]
        emit({"ok": True, "state": state, "external": False, "pid": pid,
              "name": sess.get("name", ""), "host": sess.get("host", ""), "port": sess.get("port"),
              "audio": sess.get("audio", False), "needsCode": info["needsCode"],
              "lastError": info["lastError"], "log": "\n".join(log.splitlines()[-30:]),
              "firewall": firewall_status(True)})

    failed = bool(sess and log and not info["ended"] and (info["lastError"] or info["needsCode"]))
    recent = time.time() - float(sess.get("startedAt", 0) or 0) < 120

    # A doubletake someone started by hand (or from a terminal) still counts:
    # the widget shows it as live so the user knows the screen is in use. A
    # cast of ours that just failed is still the more useful thing to show.
    others = doubletake_processes()
    if others and not (failed and recent):
        args = proc_cmdline(others[0])
        emit({"ok": True, "state": "live", "external": True, "pid": others[0], "name": "",
              "host": arg_value(args, "-target"), "port": int(arg_value(args, "-port") or 7000),
              "audio": "-no-audio" not in args, "needsCode": False, "lastError": "", "log": "",
              "firewall": firewall_status(False)})

    state = "failed" if failed else "idle"
    emit({"ok": True, "state": state, "external": False, "pid": None,
          "name": sess.get("name", ""), "host": sess.get("host", ""), "port": sess.get("port"),
          "audio": False, "needsCode": info["needsCode"] if state == "failed" else False,
          "lastError": info["lastError"] if state == "failed" else "",
          "log": "\n".join(log.splitlines()[-30:]), "firewall": firewall_status(False)})


def forget_share_choice(device_id, path=None):
    """Make the next cast show the screen-share picker again.

    doubletake keeps the portal's restore token beside each screen's pairing
    keys and hands it back, so the picker never reappears after the first
    cast. Dropping only that token keeps the pairing. Without a device id every
    screen's token goes, which costs nothing but one more pick.
    Returns how many tokens were removed.
    """
    path = path or DOUBLETAKE_CREDS
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return 0
    if not isinstance(data, dict):
        return 0
    removed = 0
    for did, creds in data.items():
        if device_id and did.upper() != device_id.upper():
            continue
        if isinstance(creds, dict) and creds.pop("restore_token", None) is not None:
            removed += 1
    if removed:
        # Same directory, same private mode, then an atomic swap: this file
        # also holds the pairing keys.
        tmp = path + ".beam.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
        os.replace(tmp, path)
    return removed


def cmd_start(argv):
    import argparse
    ap = argparse.ArgumentParser(prog="beamctl start")
    ap.add_argument("host")
    ap.add_argument("port", type=int)
    ap.add_argument("--device-id", default="")
    ap.add_argument("--name", default="")
    ap.add_argument("--audio", action="store_true")
    ap.add_argument("--no-cursor", action="store_true")
    ap.add_argument("--code", default="")
    ap.add_argument("--choose", action="store_true")
    a = ap.parse_args(argv)

    try:
        ipaddress.ip_address(a.host)
    except ValueError:
        if not re.fullmatch(r"[A-Za-z0-9.-]{1,253}", a.host):
            emit({"ok": False, "error": "invalid host"}, 1)
    if not 1 <= a.port <= 65535:
        emit({"ok": False, "error": "invalid port"}, 1)
    if a.device_id and not re.fullmatch(r"[0-9A-Fa-f:]{11,17}", a.device_id):
        a.device_id = ""

    dt = find_doubletake()
    if not dt:
        emit({"ok": False, "error": "doubletake is not installed"}, 1)

    sess = read_session()
    if sess.get("pid") and is_doubletake(sess["pid"]):
        emit({"ok": False, "error": "already casting", "pid": sess["pid"]}, 1)

    # The firewall rule names the screen's address, so a hostname is resolved
    # to the IPv4 address doubletake will reach.
    try:
        fw_host = str(ipaddress.ip_address(a.host))
    except ValueError:
        try:
            fw_host = socket.gethostbyname(a.host)
        except OSError:
            emit({"ok": False, "error": f"can't resolve {a.host}"}, 1)
    ok, msg = firewall_open(fw_host)
    if not ok:
        emit({"ok": False, "error": "The firewall wasn't opened for the screen, so the cast didn't start: " + msg}, 1)

    removed = forget_share_choice(a.device_id) if a.choose else 0

    args = [dt, "-target", a.host, "-port", str(a.port), "-port-range", PORT_RANGE]
    if a.device_id:
        args += ["-device-id", a.device_id.upper()]
    args += ["-audio-source", "output"] if a.audio else ["-no-audio"]
    if a.no_cursor:
        args.append("-no-cursor")
    if a.code:
        args.append("-pair")

    env = dict(os.environ)
    if a.code:
        env["DOUBLETAKE_CODE"] = a.code

    os.makedirs(STATE_DIR, exist_ok=True)
    logf = open(LOG_PATH, "w")
    # Beam's own first line, so a cast that reused the last pick can be told
    # from one that asked for the picker.
    logf.write(f"beam: share picker {'requested' if a.choose else 'not requested'}"
               f" (removed {removed} saved pick{'s' if removed != 1 else ''})\n")
    logf.flush()
    # A new session keeps the cast alive when the shell reloads its plugins.
    p = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=logf, stderr=subprocess.STDOUT,
                         env=env, start_new_session=True)
    logf.close()

    prev_sink = ""
    if "BEAM_PREV_SINK" in os.environ:
        prev_sink = os.environ["BEAM_PREV_SINK"]
    elif a.audio:
        code, out, _ = run(["pactl", "get-default-sink"], timeout=3)
        prev_sink = out.strip() if code == 0 else ""
    handover = os.environ.get("BEAM_HANDOVER_FROM", "")
    write_session({"pid": p.pid, "host": a.host, "port": a.port, "name": a.name,
                   "deviceId": a.device_id, "audio": a.audio, "prevSink": prev_sink,
                   "startedAt": time.time(), "choose": a.choose, "picksRemoved": removed,
                   "cursor": not a.no_cursor, "handoverFrom": int(handover) if handover.isdigit() else None})

    helper = [sys.executable, os.path.realpath(__file__)]
    quiet = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                 start_new_session=True)
    if a.audio:
        subprocess.Popen(helper + ["_route-audio", str(p.pid)], **quiet)
    subprocess.Popen(helper + ["_watch", str(p.pid)], **quiet)
    emit({"ok": True, "pid": p.pid, "args": args[1:], "firewall": msg})


def cmd_route_audio(pid):
    """Wait for doubletake's sink, then make it the default output."""
    deadline = time.time() + 45
    while time.time() < deadline and is_doubletake(pid):
        if "[AUDIO] select output doubletake" in tail(LOG_PATH, 200):
            run(["pactl", "set-default-sink", "doubletake"], timeout=3)
            return
        time.sleep(0.5)


def restore_sink(prev):
    if not prev or prev == "doubletake":
        return
    code, out, _ = run(["pactl", "list", "short", "sinks"], timeout=3)
    if any(line.split("\t")[1:2] == [prev] for line in out.splitlines()):
        run(["pactl", "set-default-sink", prev], timeout=3)


def wait_exit(pid, seconds):
    end = time.time() + seconds
    while time.time() < end:
        if not is_doubletake(pid):
            return True
        time.sleep(0.1)
    return not is_doubletake(pid)


def stop_cast():
    """Stop the cast (Beam's, else any doubletake); returns the pids stopped."""
    sess = read_session()
    pids = [sess["pid"]] if sess.get("pid") and is_doubletake(sess["pid"]) else doubletake_processes()
    if not pids:
        restore_sink(sess.get("prevSink", ""))
        return []
    for pid in pids:
        for sig, wait in ((signal.SIGINT, 5), (signal.SIGTERM, 3), (signal.SIGKILL, 2)):
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                break
            if wait_exit(pid, wait):
                break
    restore_sink(sess.get("prevSink", ""))
    if sess:
        sess["pid"] = None
        write_session(sess)
    return pids


def cmd_stop():
    pids = stop_cast()
    if not pids:
        emit({"ok": True, "stopped": False, "message": "Nothing is casting"})
    emit({"ok": True, "stopped": True, "pids": pids})


# ----------------------------------------------------------------- uninstall

def required_by_others(pkg, removing):
    """None if pkg isn't installed, else (packages outside the removal set
    that require it, packages that use it optionally)."""
    code, out, _ = run(["pacman", "-Qi", pkg], timeout=5)
    if code != 0:
        return None
    found = {}
    for key in ("Required By", "Optional For"):
        m = re.search(rf"^{key}\s*:\s*(.*(?:\n\s{{2,}}.*)*)", out, re.M)
        found[key] = [n for n in (m.group(1).split() if m else []) if n != "None" and n not in removing]
    return found["Required By"], found["Optional For"]


def uninstall_plan(record, all_packages, installed_files, required):
    """What uninstall will do, as (description, shell command or None) steps.

    record: SETUP_RECORD contents. installed_files: which system and user
    paths exist. required(pkg, removing) -> None if not installed, else the
    packages outside the removal set that still need it. Pure, for testing.
    """
    steps = []
    if installed_files.get("helpers"):
        steps.append(("Remove the firewall helpers and their polkit policy",
                      f"sudo rm -f {' '.join(shlex_quote(os.path.join(HELPER_DIR, h)) for h in HELPERS.values())} "
                      f"{shlex_quote(POLICY_PATH)} && sudo rmdir --ignore-fail-on-non-empty {shlex_quote(HELPER_DIR)}"))
    if record.get("avahiEnabled"):
        steps.append(("Turn avahi off again (setup turned it on)", "sudo systemctl disable --now avahi-daemon"))

    candidates = list(record.get("packages", []))
    if all_packages:
        candidates += [p for p in REQUIRED_PACKAGES + OPTIONAL_PACKAGES if p not in candidates]
    removing = set(candidates)
    def short(names):
        return ", ".join(names[:4]) + ("…" if len(names) > 4 else "")

    remove, keep = [], []
    for pkg in candidates:
        found = required(pkg, removing)
        if found is None:
            continue
        needed, optional = found
        (keep if needed else remove).append((pkg, needed, optional))
    if remove:
        names = " ".join(p for p, _, _ in remove)
        steps.append((f"Remove packages: {names}", f"sudo pacman -Rsu {names}"))
        for pkg, _, optional in remove:
            if optional:
                steps.append((f"  note: {pkg} is optional for {short(optional)}", None))
    for pkg, needed, _ in keep:
        steps.append((f"Keep {pkg}: needed by {short(needed)}", None))

    for label, path in (("doubletake", LIB_DIR), ("cast state and logs", STATE_DIR),
                        ("setup record", DATA_DIR),
                        ("doubletake pairings and saved picks", os.path.dirname(DOUBLETAKE_CREDS))):
        if installed_files.get(path):
            steps.append((f"Delete {label} ({path.replace(HOME, '~')})", None))
    if installed_files.get("plugin"):
        steps.append(("Remove the Beam plugin from the bar", None))
    return steps


def cmd_uninstall(argv):
    """Undo setup and remove Beam. Human-readable, like setup."""
    dry = "--dry-run" in argv
    yes = "--yes" in argv
    all_packages = "--all-packages" in argv
    if "--terminal" in argv:
        open_terminal(["uninstall"] + [a for a in argv if a in ("--all-packages",)])
        emit({"ok": True, "launched": True})

    plugin_dir = PLUGIN_DIR if os.path.basename(PLUGIN_DIR) == "beam.cast" else ""
    files = {
        "helpers": any(os.path.exists(dest) for _, dest, _ in system_files()),
        "plugin": bool(plugin_dir),
    }
    for path in (LIB_DIR, STATE_DIR, DATA_DIR, os.path.dirname(DOUBLETAKE_CREDS)):
        files[path] = os.path.exists(path)
    record = read_record()
    steps = uninstall_plan(record, all_packages, files, required_by_others)

    casting = bool(doubletake_processes())
    fw = read_firewall().get("host")
    print("Beam uninstall will:")
    if casting:
        print("  - Stop the cast")
    if fw:
        print(f"  - Close the firewall opening for {fw}")
    for desc, _ in steps:
        print("  -", desc)
    if not record.get("packages") and not all_packages:
        print("  (Setup didn't install any packages here. Add --all-packages to also offer\n"
              "   removing the casting packages that nothing else needs.)")
    if dry:
        return
    if not yes:
        try:
            if input("Continue? [y/N] ").strip().lower() not in ("y", "yes"):
                print("Nothing changed.")
                return
        except EOFError:
            print("No answer; nothing changed. Use --yes to skip the question.")
            sys.exit(1)

    if casting:
        stop_cast()
        time.sleep(1.5)  # the cast's watcher closes the firewall as it exits
    if read_firewall().get("host"):
        ok, msg = firewall_close()
        print("  firewall:", msg)
    for desc, cmd in steps:
        if cmd:
            print("+", cmd)
            if subprocess.call(cmd, shell=True) != 0:
                print(f"  failed; continuing ({desc})")
    for path in (LIB_DIR, STATE_DIR, DATA_DIR, os.path.dirname(DOUBLETAKE_CREDS)):
        shutil.rmtree(path, ignore_errors=True)
    if plugin_dir:
        # Last, since it deletes this script; Python has already read it.
        subprocess.call(["omarchy", "plugin", "remove", "beam.cast", "--yes"])
        parent = os.path.dirname(plugin_dir)
        for name in os.listdir(parent):
            if name.startswith(".beam.cast.bak."):
                shutil.rmtree(os.path.join(parent, name), ignore_errors=True)
    print("Beam is uninstalled.")


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "discover":
        cmd_discover("--all" in rest)
    elif cmd == "doctor":
        cmd_doctor()
    elif cmd == "fix":
        cmd_fix()
    elif cmd == "install-doubletake":
        cmd_install_doubletake()
    elif cmd == "setup":
        cmd_setup()
    elif cmd == "uninstall":
        cmd_uninstall(rest)
    elif cmd == "start":
        cmd_start(rest)
    elif cmd == "stop":
        cmd_stop()
    elif cmd == "status":
        cmd_status()
    elif cmd == "change-source":
        cmd_change_source()
    elif cmd == "firewall-close":
        cmd_firewall_close()
    elif cmd == "_watch" and rest:
        cmd_watch(int(rest[0]))
    elif cmd == "_route-audio" and rest:
        cmd_route_audio(int(rest[0]))
    else:
        emit({"ok": False, "error": f"unknown command {cmd}"}, 2)


if __name__ == "__main__":
    main()
