#!/usr/bin/env python3
"""beamctl: the helper behind the Beam bar widget.

Finds AirPlay screens on the local network, checks that this machine can cast
to them, and starts or stops a doubletake mirroring session. Every command
prints one JSON object on stdout, so the QML side never parses free text.

Commands:
  discover [--all]             list AirPlay screens with the port that answers RTSP
                               (--all also lists audio-only receivers such as speakers)
  doctor                       check packages, services, firewall and the doubletake binary
  fix                          open a terminal that runs the fix commands doctor suggests
  install-doubletake           download the pinned doubletake release into ~/.local/lib/beam
  setup                        install doubletake, then run the fix commands here (asks for sudo)
  uninstall [--dry-run] [--yes] [--all-packages]
                               undo everything Beam set up and remove the plugin (asks for sudo);
                               --all-packages also offers the casting packages setup didn't install
  start HOST PORT [options]    start casting (--device-id ID --name NAME --audio --no-cursor --code PIN
                               --choose: show the screen-share picker again instead of reusing the last pick)
  stop                         stop the cast and put the previous sound output back
  change-source                restart the running cast with the screen-share picker, keeping
                               the firewall rule and sound routing (a ~2 s reconnect on the screen)
  firewall-close               remove the firewall rule a cast opened (asks for your password)
  status                       what is casting now, read from the process and its log
"""

import concurrent.futures
import hashlib
import ipaddress
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.request

